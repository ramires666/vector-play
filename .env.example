# VectorPlay — локальные настройки. Скопируйте этот файл в .env (он в .gitignore)
# и поменяйте значения под себя. Docker Compose подхватывает .env автоматически,
# start.sh / start.bat тоже читают его при запуске.
#
# cp .env.example .env        # Linux/macOS
# copy .env.example .env      # Windows

# --- Модели ------------------------------------------------------------------
# Какие модели видны на этом запуске (остальные не грузятся и не качаются).
# VECTOR_CALC_ENABLED_MODELS=en-small,ru-rusvectores
# Модель по умолчанию (грузится при старте).
# VECTOR_CALC_DEFAULT_MODEL=en-small

# --- Модерация ---------------------------------------------------------------
# Режим: off | warn | queue | strict
VECTOR_CALC_MODERATION=queue
# Профиль аудитории: teen — мягче (до 18), kids — строже (от 7 лет).
VECTOR_CALC_MODERATION_PROFILE=teen
# Режим показа коллекции по умолчанию: kids | teen | off.
# Ручной выбор в шестерёнке сохраняется в браузере и перекрывает это значение.
VECTOR_CALC_DEFAULT_MODE=kids

# --- LLM для модерации (OpenAI-совместимый адрес) ----------------------------
# Пусто — работают только словари и векторные эвристики, без LLM.
VECTOR_CALC_LLM_URL=http://192.168.1.102:8080/v1
VECTOR_CALC_LLM_MODEL=local
# Пароль/ключ LLM, если он требуется (уйдёт в заголовок Authorization).
# VECTOR_CALC_LLM_API_KEY=
# Без «размышлений» модель отвечает ~1 c вместо 5–10 c.
VECTOR_CALC_LLM_NO_THINK=1
# VECTOR_CALC_LLM_TIMEOUT=60

# --- Админ -------------------------------------------------------------------
# Токен для очереди модерации, переоценки и ручных правок. Обязательно смените!
VECTOR_CALC_ADMIN_TOKEN=xxx111xxx333
